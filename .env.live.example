# Copy to .env.live and fill in your live database URL
# .env.live is gitignored – never commit real credentials

# Recommended for most uses (pooled)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# For migrations – unpooled/direct connection (some providers need this)
DATABASE_URL_UNPOOLED=postgresql://user:password@host-unpooled/database?sslmode=require
